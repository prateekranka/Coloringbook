<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ── Identity ─────────────────────────────────────────── -->
	<key>CFBundleName</key>
	<string>Gouache</string>

	<key>CFBundleDisplayName</key>
	<string>Gouache</string>

	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<!-- ── Platform ──────────────────────────────────────────── -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- iPad only: all four orientations -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Launch Screen ──────────────────────────────────────────────── -->
	<!-- UILaunchScreen replaces LaunchScreen.storyboard.                 -->
	<!-- Matches app dark background so the SwiftUI splash never flashes white. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>CFBackground</string>
	</dict>

	<!-- ── Scene lifecycle (SwiftUI @main) ───────────────────── -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>

	<!-- ── App transport ──────────────────────────────────────── -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- ── Privacy ─────────────────────────────────────────────── -->
		<!-- Write: save finished artwork to Photos (used today). -->
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Gouache needs permission to save your artwork to the Photos library.</string>

		<!-- ── Base orientation key (required alongside ~ipad variant) ── -->
	<!-- Mirrors ~ipad variant so Split View / Slide Over don't hit an empty-set edge case. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Custom fonts ─────────────────────────────────────────────── -->
	<key>UIAppFonts</key>
	<array>
		<string>Fraunces.ttf</string>
	</array>

	<!-- ── Export compliance ─────────────────────────────────────── -->
	<!-- App uses no custom cryptography and only Apple-provided TLS. -->
	<!-- Declaring this up front avoids the per-upload TestFlight prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

</dict>
</plist>
