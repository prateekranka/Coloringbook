default_platform(:ios)

platform :ios do
  desc "Upload the exported IPA to TestFlight and distribute it to configured tester groups"
  lane :testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    groups = ENV.fetch("TESTFLIGHT_GROUPS", "")
                .split(",")
                .map(&:strip)
                .reject(&:empty?)

    options = {
      api_key: api_key,
      ipa: ENV.fetch("IPA_PATH"),
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Automated TestFlight build"),
      skip_waiting_for_build_processing: false,
      uses_non_exempt_encryption: false
    }

    unless groups.empty?
      options[:groups] = groups
      options[:distribute_external] = true
      options[:notify_external_testers] = true
    end

    upload_to_testflight(**options)
  end
end
