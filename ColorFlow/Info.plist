<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ── Identity ─────────────────────────────────────────── -->
	<key>CFBundleName</key>
	<string>ColorFlow</string>

	<key>CFBundleDisplayName</key>
	<string>ColorFlow</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<!-- ── Platform ──────────────────────────────────────────── -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- iPad only: all four orientations -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Launch Screen (fixes "Launch screens will soon be required") ── -->
	<!-- UILaunchScreen replaces LaunchScreen.storyboard for iOS 14+      -->
	<!-- Shows app icon on a plain background; no custom layout needed.    -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- ── Scene lifecycle (SwiftUI @main) ───────────────────── -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>

	<!-- ── App transport ──────────────────────────────────────── -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- ── Privacy ─────────────────────────────────────────────── -->
	<!-- Write: save finished artwork to Photos (used today). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ColorFlow needs permission to save your artwork to the Photos library.</string>

	<!-- Read: import a photo and turn it into a coloring page (Phase C). -->
	<!-- Shipped early so the string is reviewed once, not twice. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ColorFlow can turn a photo from your library into a hand-drawn coloring page. The photo stays on your device and is never uploaded.</string>

	<!-- Camera capture → coloring page (Phase C). Same early-ship rationale. -->
	<key>NSCameraUsageDescription</key>
	<string>ColorFlow can use your camera to turn a photo into a hand-drawn coloring page. The image stays on your device and is never uploaded.</string>

	<!-- ── Base orientation key (required alongside ~ipad variant) ── -->
	<!-- Mirrors ~ipad variant so Split View / Slide Over don't hit an empty-set edge case. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Export compliance ─────────────────────────────────────── -->
	<!-- App uses no custom cryptography and only Apple-provided TLS. -->
	<!-- Declaring this up front avoids the per-upload TestFlight prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ── Remote content catalogue (CDN-hosted templates.json) ─────
	     Leave empty in source; operators override per-environment via an
	     xcconfig or the App Store Connect build-time edit. When empty,
	     ContentService short-circuits and the bundled catalogue is used. -->
	<key>ContentManifestURL</key>
	<string></string>

	<!-- ── Background modes for CloudKit push notifications ─────── -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

</dict>
</plist>
