// Local signing configuration — NOT committed to git.
//
// Setup (one-time):
//   1. Copy this file:  cp local.xcconfig.template local.xcconfig
//   2. Find your Team ID:
//        grep "DEVELOPMENT_TEAM" ColorFlow.xcodeproj/project.pbxproj | head -3
//      or:
//        security find-identity -v -p codesigning | grep "Apple Development"
//      The 10-character ID appears in parentheses at the end of the line.
//   3. Replace XXXXXXXXXX below with your actual Team ID.
//   4. Re-run: xcodegen generate
//
// local.xcconfig is listed in .gitignore and will not be pushed to the remote.

DEVELOPMENT_TEAM = XXXXXXXXXX
