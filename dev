#!/usr/bin/env bash
# ColorFlow dev entrypoint — single command for the full build/test loop.
#
# Usage:
#   ./dev               # regenerate project + build + run unit tests
#   ./dev gen           # xcodegen only
#   ./dev build         # build for simulator (no tests)
#   ./dev test          # build + unit tests
#   ./dev uitest        # build + UI tests
#   ./dev all           # unit + UI tests
#   ./dev open          # open ColorFlow.xcodeproj in Xcode
#   ./dev simlist       # list available iPad simulators
#   ./dev help
#
# Simulator selection:
#   COLORFLOW_SIM       simulator name (overrides auto-detection)
#   COLORFLOW_SIM_UDID  explicit UDID (wins over COLORFLOW_SIM)

set -euo pipefail

SCHEME="ColorFlow"
PROJECT="ColorFlow.xcodeproj"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

# ── Logging helpers ──────────────────────────────────────────────────────────
info()  { printf "\033[1;34m[dev]\033[0m %s\n" "$*"; }
warn()  { printf "\033[1;33m[dev]\033[0m %s\n" "$*" >&2; }
fail()  { printf "\033[1;31m[dev]\033[0m %s\n" "$*" >&2; exit 1; }

ensure_xcodegen() {
    command -v xcodegen >/dev/null 2>&1 || fail "xcodegen not installed. Run: brew install xcodegen"
}

# ── Direct xcodebuild backend ────────────────────────────────────────────────
xb_resolve_simulator() {
    if [[ -n "${COLORFLOW_SIM_UDID:-}" ]]; then
        printf "%s" "$COLORFLOW_SIM_UDID"; return
    fi
    local name_filter="${COLORFLOW_SIM:-}"
    local udid
    udid=$(xcrun simctl list devices available --json 2>/dev/null | /usr/bin/python3 -c "
import json, sys, os
want = os.environ.get('COLORFLOW_SIM', '').strip()
data = json.load(sys.stdin)
booted = newest = None
for rt_key, devs in data['devices'].items():
    if 'iOS' not in rt_key: continue
    for d in devs:
        n = d.get('name','')
        if want:
            if n == want:
                print(d['udid']); sys.exit(0)
            continue
        if 'iPad' not in n: continue
        if d.get('state') == 'Booted':
            booted = d
        newest = d  # iteration order: newest runtime first in simctl output
if booted: print(booted['udid'])
elif newest: print(newest['udid'])
else: sys.exit(1)
") || fail "No iPad simulator found${name_filter:+ matching '$name_filter'}."
    printf "%s" "$udid"
}

xb_build() {
    local udid; udid=$(xb_resolve_simulator)
    info "Building $SCHEME on simulator ${udid}…"
    xcodebuild -project "$PROJECT" -scheme "$SCHEME" \
        -destination "platform=iOS Simulator,id=$udid" \
        -configuration Debug build
}

xb_test() {
    local udid; udid=$(xb_resolve_simulator)
    info "Running unit tests on ${udid}…"
    xcodebuild test -project "$PROJECT" -scheme "$SCHEME" \
        -destination "platform=iOS Simulator,id=$udid" \
        -only-testing:ColorFlowTests -configuration Debug
}

xb_uitest() {
    local udid; udid=$(xb_resolve_simulator)
    info "Running UI tests on ${udid}…"
    xcodebuild test -project "$PROJECT" -scheme "$SCHEME" \
        -destination "platform=iOS Simulator,id=$udid" \
        -only-testing:ColorFlowUITests -configuration Debug
}

xb_simlist() {
    xcrun simctl list devices available | grep -E "iPad.*\(" | sed 's/^[[:space:]]*/  /'
}

# ── Commands ─────────────────────────────────────────────────────────────────
cmd_gen() {
    ensure_xcodegen
    info "Regenerating $PROJECT from project.yml…"
    xcodegen generate
    info "Done."
}

cmd_build()   { [[ -d "$PROJECT" ]] || cmd_gen; xb_build; }
cmd_test()    { [[ -d "$PROJECT" ]] || cmd_gen; xb_test; }
cmd_uitest()  { [[ -d "$PROJECT" ]] || cmd_gen; xb_uitest; }
cmd_all()     { cmd_test; cmd_uitest; }
cmd_open()    { [[ -d "$PROJECT" ]] || cmd_gen; open "$PROJECT"; }
cmd_simlist() { info "iPad simulators:"; xb_simlist; }
cmd_help()    { sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# ── Dispatch ─────────────────────────────────────────────────────────────────
cmd="${1:-test}"
shift || true

case "$cmd" in
    gen)            cmd_gen     ;;
    build)          cmd_build   ;;
    test)           cmd_test    ;;
    uitest)         cmd_uitest  ;;
    all)            cmd_all     ;;
    open)           cmd_open    ;;
    simlist)        cmd_simlist ;;
    help|-h|--help) cmd_help    ;;
    *)              warn "Unknown command: $cmd"; cmd_help; exit 2 ;;
esac
